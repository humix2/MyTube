<Window x:Class="MyTube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MyTube" Icon="Assets/MyTube.ico" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="#0F0F0F">

    <!-- 標準のタイトルバーを消して、アプリ側で描く -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- 左メニューを畳んだときに文字を隠す（コードから書き換える） -->
        <Visibility x:Key="LabelVisibility">Visible</Visibility>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#272727" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F3F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- タイトルバーのメニュー・戻る・進む・再読み込み -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>

        <!-- 最小化・最大化・閉じる -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Foreground" Value="#F1F1F1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D3D3D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A32116" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="20" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{DynamicResource LabelVisibility}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- タイトルバー（空いている部分はドラッグで移動、ダブルクリックで最大化） -->
        <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Height="40" Background="#0F0F0F">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                <Button Style="{StaticResource ToolButton}" Content="&#xE700;" FontSize="15"
                        ToolTip="メニューを開く / 畳む" Click="ToggleSidebar_Click" />
                <Button x:Name="BackButton" Style="{StaticResource ToolButton}" Content="&#xE72B;"
                        ToolTip="戻る (Alt+←)" Click="Back_Click" IsEnabled="False" Margin="8,0,0,0" />
                <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}" Content="&#xE72A;"
                        ToolTip="進む (Alt+→)" Click="Forward_Click" IsEnabled="False" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE72C;"
                        ToolTip="再読み込み (F5)" Click="Reload_Click" />
            </StackPanel>

            <Grid Grid.Column="1" Margin="12,0">
                <TextBlock x:Name="TitleText" Text="MyTube" Foreground="#AAAAAA" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <!-- 検索欄（左メニューの「検索」か「/」キーで開く） -->
                <Border x:Name="SearchPanel" Visibility="Collapsed" MaxWidth="560" Height="30"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Background="#121212" BorderBrush="#3F3F3F" BorderThickness="1" CornerRadius="15"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Foreground="#AAAAAA"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Margin="10,0,0,0" Text="YouTube を検索"
                                   Foreground="#717171" FontSize="13" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Margin="8,0,0,0" Background="Transparent"
                                 BorderThickness="0" Foreground="#F1F1F1" CaretBrush="#F1F1F1" FontSize="13"
                                 VerticalAlignment="Center" KeyDown="SearchBox_KeyDown"
                                 TextChanged="SearchBox_TextChanged" LostKeyboardFocus="SearchBox_LostFocus" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="最小化"
                        Click="Minimize_Click" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        ToolTip="最大化" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="閉じる"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="Sidebar" Grid.Row="1" Width="200" Padding="8,0,8,8" Background="#0F0F0F"
                ClipToBounds="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#3F3F3F" Margin="4,8" />
                    <CheckBox x:Name="DimWatchedCheck" Content="視聴済みを薄く表示" Foreground="#AAAAAA"
                              Margin="10,4" Visibility="{DynamicResource LabelVisibility}"
                              Checked="DimWatched_Changed" Unchecked="DimWatched_Changed" />
                    <Button x:Name="AccountButton" Style="{StaticResource NavButton}" Click="Account_Click"
                            ToolTip="アカウント">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE77B;" />
                            <TextBlock x:Name="AccountLabel" Style="{StaticResource NavLabel}" Text="アカウント" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Extensions_Click" ToolTip="拡張機能の設定">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xEA86;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="拡張機能" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OpenDataFolder_Click"
                            ToolTip="データフォルダ（拡張機能や設定の保存場所）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE838;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="データフォルダ" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Click="OpenSearch_Click" ToolTip="検索 ( / )">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE721;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="検索" />
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="#3F3F3F" Margin="4,6" />
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/feed/subscriptions"
                            ToolTip="登録チャンネル新着">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8F1;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="登録チャンネル新着" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/" ToolTip="ホーム">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="ホーム" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/playlist?list=WL"
                            ToolTip="後で見る">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE823;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="後で見る" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/feed/playlists"
                            ToolTip="再生リスト">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8FD;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="再生リスト" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/feed/history" ToolTip="履歴">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE81C;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="履歴" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/feed/channels"
                            ToolTip="チャンネル管理">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE716;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="チャンネル管理" />
                        </StackPanel>
                    </Button>
                    <!-- 急上昇：YouTube の公式急上昇ページは 2025年7月に廃止されたため、
                         ゲームチャンネルの急上昇一覧（/gaming の「急上昇動画」の「すべて表示」先）を開く -->
                    <Border Height="1" Background="#3F3F3F" Margin="4,6" />
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click" Tag="/gaming/trending"
                            ToolTip="急上昇：ゲーム">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7FC;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="急上昇：ゲーム" />
                        </StackPanel>
                    </Button>
                    <!-- YouTube 音楽チャンネル（UC-9-kyTW8ZkZNDHQJ6FgpwQ）の再生リスト「人気上昇中の曲 - 日本」。
                         開けなくなったら、そのチャンネルのページから新しい ID を取り直す -->
                    <Button Style="{StaticResource NavButton}" Click="Nav_Click"
                            Tag="/playlist?list=OLAK5uy_nMa6r07BbcC_Q8PrrS1CVHH2aGJRIkWu0"
                            ToolTip="急上昇：音楽（人気上昇中の曲 - 日本）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavIcon}" Text="&#xE8D6;" />
                            <TextBlock Style="{StaticResource NavLabel}" Text="急上昇：音楽" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 右と下を少し空けて、そこでウィンドウのサイズ変更ができるようにする
             （WebView2 の上ではサイズ変更のカーソルが出ないため） -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" Grid.Column="1" Margin="0,0,5,5" />
    </Grid>
</Window>
